[Unit]
Description=Niffler rn01 PostgreSQL backup to Cloudflare R2
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=niffler-postgres-backup-alert.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/niffler-postgres-backup
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
TimeoutStartSec=2h
ExecStartPost=-/usr/local/sbin/niffler-postgres-backup-alert success
