[Unit]
Description=Receive Niffler Telegram monitor commands
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/niffler-monitor-bot-controller run
User=root
Group=root
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
NoNewPrivileges=true
StateDirectory=niffler-monitor-bot
StateDirectoryMode=0700
ReadWritePaths=/var/lib/niffler-monitor-bot
TimeoutStartSec=1m
