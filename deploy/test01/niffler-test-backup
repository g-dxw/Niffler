#!/bin/bash

set -euo pipefail

APP_DIR="/opt/niffler-test"
BACKUP_DIR="$APP_DIR/backups/postgres"
TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
BACKUP_PATH="$BACKUP_DIR/aether-$TIMESTAMP.dump"

mkdir -p "$BACKUP_DIR"
cd "$APP_DIR"
docker compose exec -T postgres sh -c 'exec pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' > "$BACKUP_PATH"
test -s "$BACKUP_PATH"
find "$BACKUP_DIR" -type f -name 'aether-*.dump' -mtime +7 -delete
find "$BACKUP_DIR" -type f -name 'aether-*.dump.sha256' -mtime +7 -delete
sha256sum "$BACKUP_PATH" > "$BACKUP_PATH.sha256"
